# standalone.demo — independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema `sdkwork_shop_demo` and a
# dedicated Redis logical DB index so no shared-redis cache key (rate-limit, session, idempotency)
# ever collides with another shared-redis environment.
SDKWORK_SHOP_DEPLOYMENT_PROFILE=standalone
SDKWORK_SHOP_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_SHOP_PROFILE_ID=standalone.demo
VITE_SDKWORK_SHOP_DEPLOYMENT_PROFILE=standalone

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_SHOP_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Dedicated demo ingress bind/ports (kept apart from development 8080) so a meaningfully distinct
# origin can be published externally for system demonstrations.
SDKWORK_SHOP_APPLICATION_PUBLIC_INGRESS_BIND=0.0.0.0:18076
SDKWORK_SHOP_APPLICATION_PUBLIC_HTTP_URL=http://shop-demo.sdkwork.com:18076
VITE_SDKWORK_SHOP_APPLICATION_PUBLIC_HTTP_URL=http://shop-demo.sdkwork.com:18076

# Redis isolation: point the demo at a dedicated logical DB index on the shared Redis so hardcoded
# service prefixes remain confined to this environment and can never collide with dev/test/staging/prod.
SDKWORK_SHOP_REDIS_URL=redis://127.0.0.1:6379/15
SDKWORK_SHOP_REDIS_ENABLED=true
SDKWORK_CORS_ALLOWED_ORIGINS=https://shop-demo.sdkwork.com,http://shop-demo.sdkwork.com,https://shop-demo.birdcoder.com,http://shop-demo.birdcoder.com,https://shop-demo.dtupay.com,http://shop-demo.dtupay.com,https://shop-demo.noaper.com,http://shop-demo.noaper.com,https://shop-demo.sdkwork.cn,http://shop-demo.sdkwork.cn,https://shop-demo.birdcoder.cn,http://shop-demo.birdcoder.cn,https://shop-demo.dtupay.cn,http://shop-demo.dtupay.cn,https://shop-demo.noaper.cn,http://shop-demo.noaper.cn,https://shop-demo.skubc.com,http://shop-demo.skubc.com,https://shop-demo.skubc.cn,http://shop-demo.skubc.cn,https://shop-demo.zowalk.com,http://shop-demo.zowalk.com,https://shop-demo.zowalk.cn,http://shop-demo.zowalk.cn,https://shop-demo.offer86.com,http://shop-demo.offer86.com,https://shop-demo.offer86.cn,http://shop-demo.offer86.cn,https://shop-demo.86offer.com,http://shop-demo.86offer.com,https://shop-demo.86offer.cn,http://shop-demo.86offer.cn,app://dsh,app://birdcoder,app://sdkwork,app://dtupay,tauri://localhost,https://servicewechat.com
