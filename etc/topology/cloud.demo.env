# cloud.demo — cloud-hosted independent demonstration deployment, fully isolated from dev/test/staging/prod.
# Provisioned as its own deployment: dedicated PostgreSQL database/schema `sdkwork_shop_demo` and a
# dedicated Redis logical DB index so no cache key collides with another shared-redis environment.
SDKWORK_SHOP_DEPLOYMENT_PROFILE=cloud
SDKWORK_SHOP_ENVIRONMENT=demo
SDKWORK_ENV=demo
SDKWORK_SHOP_PROFILE_ID=cloud.demo
VITE_SDKWORK_SHOP_DEPLOYMENT_PROFILE=cloud

# Region deployment dimension (REGION_SPEC.md): orthogonal to deployment profile and environment.
SDKWORK_SHOP_REGION_CODE=cn
SDKWORK_DATABASE_SEED_LOCALE=zh-CN

# Dedicated demo public hosts (see topology.spec.json cloudPublicHosts environments["demo"]).
SDKWORK_SHOP_APPLICATION_PUBLIC_HTTP_URL=https://shop-demo.sdkwork.com
SDKWORK_SHOP_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com
VITE_SDKWORK_SHOP_APPLICATION_PUBLIC_HTTP_URL=https://shop-demo.sdkwork.com
VITE_SDKWORK_SHOP_PLATFORM_API_GATEWAY_HTTP_URL=https://api-demo.sdkwork.com

# Redis isolation: dedicate a logical DB index so hardcoded service prefixes never collide across environments.
SDKWORK_SHOP_REDIS_URL=redis://127.0.0.1:6379/15
SDKWORK_SHOP_REDIS_ENABLED=true
