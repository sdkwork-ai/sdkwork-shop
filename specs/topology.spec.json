{
  "schemaVersion": 5,
  "kind": "sdkwork.app.topology",
  "appId": "sdkwork-shop",
  "applicationCode": "shop",
  "archetype": "application-http-gateway",
  "profileRoot": "etc/topology",
  "profilePattern": "{deploymentProfile}.{environment}.env",
  "vocabulary": {
    "deploymentProfile": {
      "allowed": [
        "standalone",
        "cloud"
      ]
    },
    "environment": {
      "allowed": [
        "development",
        "test",
        "staging",
        "production"
      ]
    }
  },
  "defaults": {
    "developmentProfileId": "standalone.development",
    "productionProfileId": "cloud.production",
    "desktopBuildProfileId": "standalone.production",
    "gatewayBind": "127.0.0.1:8080"
  },
  "profileFiles": {
    "standalone.development": "etc/topology/standalone.development.env",
    "standalone.production": "etc/topology/standalone.production.env",
    "cloud.development": "etc/topology/cloud.development.env",
    "cloud.production": "etc/topology/cloud.production.env",
    "standalone.test": "etc/topology/standalone.test.env",
    "standalone.staging": "etc/topology/standalone.staging.env",
    "cloud.test": "etc/topology/cloud.test.env",
    "cloud.staging": "etc/topology/cloud.staging.env"
  },
  "envKeys": {
    "deploymentProfile": "SDKWORK_SHOP_DEPLOYMENT_PROFILE",
    "environment": "SDKWORK_SHOP_ENVIRONMENT",
    "profileId": "SDKWORK_SHOP_PROFILE_ID",
    "clientDeploymentProfile": "VITE_SDKWORK_SHOP_DEPLOYMENT_PROFILE",
    "standaloneGatewayBind": "SDKWORK_SHOP_APPLICATION_PUBLIC_INGRESS_BIND",
    "clientApiGatewayBaseUrl": "VITE_SDKWORK_SHOP_PLATFORM_API_GATEWAY_HTTP_URL",
    "apiGatewayBaseUrl": "SDKWORK_SHOP_PLATFORM_API_GATEWAY_HTTP_URL"
  },
  "surfaces": {
    "application.public-ingress": {
      "connectivityPlane": "application",
      "protocols": [
        "http"
      ],
      "bindEnv": "SDKWORK_SHOP_APPLICATION_PUBLIC_INGRESS_BIND",
      "httpUrlEnv": "SDKWORK_SHOP_APPLICATION_PUBLIC_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_SHOP_APPLICATION_PUBLIC_HTTP_URL"
    },
    "platform.api-gateway": {
      "connectivityPlane": "platform",
      "protocols": [
        "http"
      ],
      "httpUrlEnv": "SDKWORK_SHOP_PLATFORM_API_GATEWAY_HTTP_URL",
      "clientHttpEnv": "VITE_SDKWORK_SHOP_PLATFORM_API_GATEWAY_HTTP_URL"
    }
  },
  "cloudPublicHosts": {
    "application.public-ingress": {
      "httpHost": "shop.sdkwork.com",
      "environments": {
        "development": {
          "httpHosts": [
            "shop-dev.sdkwork.com",
            "shop-dev.birdcoder.com",
            "shop-dev.dtupay.com",
            "shop-dev.sdkwork.cn",
            "shop-dev.birdcoder.cn",
            "shop-dev.dtupay.cn"
          ]
        },
        "test": {
          "httpHosts": [
            "shop-test.sdkwork.com",
            "shop-test.birdcoder.com",
            "shop-test.dtupay.com",
            "shop-test.sdkwork.cn",
            "shop-test.birdcoder.cn",
            "shop-test.dtupay.cn"
          ]
        },
        "staging": {
          "httpHosts": [
            "shop-staging.sdkwork.com",
            "shop-staging.birdcoder.com",
            "shop-staging.dtupay.com",
            "shop-staging.sdkwork.cn",
            "shop-staging.birdcoder.cn",
            "shop-staging.dtupay.cn"
          ]
        }
      },
      "httpHosts": [
        "shop.sdkwork.com",
        "shop.birdcoder.com",
        "shop.dtupay.com",
        "shop.sdkwork.cn",
        "shop.birdcoder.cn",
        "shop.dtupay.cn"
      ]
    },
    "platform.api-gateway": {
      "httpHost": "api.sdkwork.com",
      "environments": {
        "development": {
          "httpHosts": [
            "api-dev.sdkwork.com",
            "api-dev.birdcoder.com",
            "api-dev.dtupay.com",
            "api-dev.sdkwork.cn",
            "api-dev.birdcoder.cn",
            "api-dev.dtupay.cn"
          ]
        },
        "test": {
          "httpHosts": [
            "api-test.sdkwork.com",
            "api-test.birdcoder.com",
            "api-test.dtupay.com",
            "api-test.sdkwork.cn",
            "api-test.birdcoder.cn",
            "api-test.dtupay.cn"
          ]
        },
        "staging": {
          "httpHosts": [
            "api-staging.sdkwork.com",
            "api-staging.birdcoder.com",
            "api-staging.dtupay.com",
            "api-staging.sdkwork.cn",
            "api-staging.birdcoder.cn",
            "api-staging.dtupay.cn"
          ]
        }
      },
      "httpHosts": [
        "api.sdkwork.com",
        "api.birdcoder.com",
        "api.dtupay.com",
        "api.sdkwork.cn",
        "api.birdcoder.cn",
        "api.dtupay.cn"
      ]
    }
  },
  "components": {
    "applicationServer": {
      "crate": "sdkwork-api-shop-standalone-gateway",
      "binary": "shop-server"
    }
  },
  "orchestration": {
    "profiles": {
      "standalone.development": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-shop-standalone-gateway",
            "binary": "shop-server",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ]
      },
      "cloud.development": {
        "processes": [],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      },
      "cloud.production": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-shop-standalone-gateway",
            "binary": "shop-server",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      },
      "standalone.production": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-shop-standalone-gateway",
            "binary": "shop-server",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ]
      },
      "standalone.test": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-shop-standalone-gateway",
            "binary": "shop-server",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ]
      },
      "standalone.staging": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-shop-standalone-gateway",
            "binary": "shop-server",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress"
        ]
      },
      "cloud.test": {
        "processes": [],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      },
      "cloud.staging": {
        "processes": [
          {
            "id": "application.public-ingress",
            "crate": "sdkwork-api-shop-standalone-gateway",
            "binary": "shop-server",
            "required": true,
            "role": "api-standalone-gateway"
          }
        ],
        "healthSurfaces": [
          "application.public-ingress",
          "platform.api-gateway"
        ]
      }
    }
  },
  "packaging": {
    "cloudConfigFiles": [],
    "targets": [
      {
        "id": "container-noarch-cloud-container-config-bundle-tar-gz",
        "profile": "container",
        "platform": "container",
        "architecture": "noarch",
        "formats": [
          "tar.gz"
        ],
        "runner": "ubuntu-24.04",
        "outputGlob": "dist/cloud-config/sdkwork-shop-api-gateway-config-*.tar.gz",
        "deploymentProfile": "cloud",
        "runtimeTarget": "container",
        "variant": "config-bundle"
      }
    ]
  }
}
